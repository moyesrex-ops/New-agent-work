{
  "name": "stampa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "env:example": "tsx scripts/build-env-example.mts",
    "env:check": "tsx scripts/build-env-example.mts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env.local scripts/seed.mts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "copy:check": "node scripts/check-copy.mjs",
    "verify": "npm run tokens:check && npm run env:check && npm run assets:check && npm run copy:check && npm run typecheck && npm run lint && npm run test",
    "walk": "tsx --env-file-if-exists=.env.local scripts/walk.mts",
    "assets": "node scripts/build-public-assets.mjs",
    "assets:check": "node scripts/build-public-assets.mjs --check",
    "budget": "tsx --env-file-if-exists=.env.local scripts/budget.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.38.0",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}

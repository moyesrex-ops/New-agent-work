# Generated from src/lib/env.ts by `npm run env:example`. Do not edit.
#
# Copy to .env.local for development. Never commit real values.
# Entries marked (required in production) block boot when unset.

# ---- Database ----

# A pglite:// URL runs an embedded Postgres for local development and needs
# no service installed. Production is a standard postgres:// connection
# string. PGlite is refused in production: a serverless filesystem is not a database.
# (required in production)
DATABASE_URL=pglite://./.data/dev

# ---- Application ----

# Absolute origin. Every WhatsApp and SMS deep link is built from it, so a
# wrong value here sends suppliers to a dead page rather than to their
# invoice. No trailing slash.
# (required in production)
APP_URL=http://localhost:3000

# Legacy flag. Production refuses it. Local tests may still set it to exercise
# the disabled-door guard. Never set this on a real buyer.
STAMPA_DEMO=

# Bearer token Vercel sends to /api/cron/retry. Empty disables the route.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- E-invoicing gateway ----

# Which transmission path is live: fake | hold | sandbox | partner.
# `fake` is local and tests only. `hold` is production without an accredited
# APP/SI: the site runs, stamps fail closed, and no IRN is invented.
# `sandbox` and `partner` require the credentials below.
STAMPA_GATEWAY=fake

# Artificial delay on the fake gateway, so the waiting states get exercised
# in development instead of only in production.
STAMPA_FAKE_LATENCY_MS=1200

# Accredited APP/SI partner base URL (Interswitch SwitchTax or equivalent).
# Required when STAMPA_GATEWAY is sandbox or partner.
APP_PARTNER_BASE_URL=https://sandbox-api.interswitchng.com

# OAuth client id for POST /Api/SwitchTax/Token.
APP_PARTNER_CLIENT_ID=

# OAuth client secret for POST /Api/SwitchTax/Token.
APP_PARTNER_CLIENT_SECRET=

# NRS/APP business_id sent on SignInvoice. Issued by the accredited partner
# when the buyer or Stampa is enrolled.
APP_PARTNER_BUSINESS_ID=

# Service id used in the IRN candidate InvoiceNo-ServiceId-YYYYMMDD.
APP_PARTNER_SERVICE_ID=STAMPA

# ---- Secrets ----

# Peppers the one-time codes before they are hashed, so a database read
# does not yield a usable credential. Generate with: openssl rand -base64 32
# Rotating it invalidates codes in flight, which is acceptable; they live
# for ten minutes.
# (required in production)
OTP_PEPPER=

# ---- Operator console ----

# Comma-separated emails allowed to open /ops. Empty means nobody can,
# which is the correct default: an operator console that anyone can reach is
# worse than no operator console.
STAMPA_OPERATORS=

# ---- Messaging ----

# Termii API key. Production OTP is SMS on the DND route, then WhatsApp,
# then voice. Without this key, codes would only exist in a server log.
TERMII_API_KEY=

# Approved Termii sender id. Talert and SecureOTP are the stock OTP ids.
# A custom Stampa id needs Termii approval first.
TERMII_SENDER_ID=Talert

# Termii API origin. Default is the Nigerian cluster.
TERMII_BASE_URL=https://api.ng.termii.com

# Optional Meta Cloud API token. Used when Termii WhatsApp is not available.
# OTP templates must be pre-approved by Meta.
WHATSAPP_TOKEN=

# Meta Cloud API phone-number id, required with WHATSAPP_TOKEN.
WHATSAPP_PHONE_NUMBER_ID=

# Approved WhatsApp authentication template name. Empty sends a session text.
WHATSAPP_OTP_TEMPLATE=

# AgentMail API key. Sends buyer and operator magic links from the company
# inbox stampa-support@agentmail.to.
AGENTMAIL_API_KEY=

# AgentMail inbox id, usually the address itself.
AGENTMAIL_INBOX_ID=stampa-support@agentmail.to

# Optional Resend key, used when AgentMail is not configured.
RESEND_API_KEY=

# From header for Resend. AgentMail uses the inbox address.
MAIL_FROM=Stampa <stampa-support@agentmail.to>

# Public support address shown on the site and help screen.
SUPPORT_EMAIL=stampa-support@agentmail.to

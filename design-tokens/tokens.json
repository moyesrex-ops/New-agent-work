{
  "$meta": {
    "name": "Stampa design tokens",
    "version": "0.1.0",
    "locked": "Phase 9",
    "note": "Single source of truth. CSS and TypeScript are generated from this file by build_tokens.py. Do not hand-edit the generated files."
  },
  "color": {
    "paper": {
      "DEFAULT": "#FBF9F4",
      "raised": "#FFFFFF",
      "sunken": "#F3F0E9"
    },
    "ink": {
      "900": "#14121A",
      "700": "#3A3543",
      "500": "#6B6675",
      "300": "#9A94A5",
      "100": "#E3DED4"
    },
    "stamp": {
      "900": "#33195E",
      "700": "#4C2A85",
      "100": "#EDE7F6"
    },
    "success": { "700": "#17604A", "100": "#E3F0EA" },
    "warning": { "700": "#8A5A00", "100": "#FBF0DC" },
    "danger": { "700": "#A32020", "100": "#FBE6E6" },
    "focus": "#4C2A85"
  },
  "font": {
    "family": {
      "sans": "Archivo, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "size": {
      "display": "32px",
      "title": "24px",
      "heading": "20px",
      "body-lg": "18px",
      "body": "16px",
      "label": "14px",
      "caption": "13px",
      "micro": "11px",
      "mono": "14px",
      "mono-lg": "20px"
    },
    "lineHeight": {
      "display": "38px",
      "title": "30px",
      "heading": "26px",
      "body-lg": "26px",
      "body": "24px",
      "label": "20px",
      "caption": "18px",
      "micro": "14px",
      "mono": "20px",
      "mono-lg": "26px"
    },
    "weight": { "regular": "400", "medium": "500", "semibold": "600" },
    "tracking": { "micro": "0.8px", "wordmark": "-0.034em" }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",

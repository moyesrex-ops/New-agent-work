    "overlay": "0 8px 24px rgba(20,18,26,0.12)"
  },
  "stroke": { "hairline": "1px", "rule": "1.5px", "icon": "1.75px" },
  "target": { "min": "48px", "primary": "56px" },
  "motion": {
    "duration": { "state": "150ms", "sheet": "200ms", "page": "240ms", "stamp": "220ms" },
    "easing": "cubic-bezier(.2,0,0,1)"
